syms t a b omega x_c y_c
x_d = x_c + a*cos(omega*t);
y_d = y_c + b*sin(omega*t)*cos(omega*t);
xy_d_matrix = [x_d; y_d]
xy_d_dot_matrix = [jacobian(x_d,t); jacobian(y_d,t)]

alpha = r_m*K_m/(2*J_eq);
