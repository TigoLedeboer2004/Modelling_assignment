for i = 1:n_steps
    U_sim(:,i) = double(subs(U_d_sim, t, t_sim(i)));
end

figure;
plot(t_sim, U_sim(1,:), 'LineWidth', 1.5);
hold on;
plot(t_sim, U_sim(2,:), 'LineWidth', 1.5);
grid on;
